#!/usr/bin/env bash
#
# dexy — keep your Mac wide awake. Lid closed, on battery, no nonsense.
#
#   dexy            toggle on/off
#   dexy on         stay awake (disable sleep, even with the lid shut)
#   dexy off        restore normal sleep
#   dexy status     show the current state
#   dexy -h         help
#   dexy -v         version
#
# Under the hood this flips macOS's `SleepDisabled` power-management flag via
# `pmset`, which is the real "don't sleep, even lid-closed" switch. Changing it
# needs sudo, so `on`/`off`/`toggle` may prompt for your password. Run
# `dexy setup-sudo` once to skip the prompt (see that command for details).
#
# MIT licensed. https://github.com/jonobri/dexy

set -euo pipefail

DEXY_VERSION="1.2.0"

# Optional sudoers drop-in that lets dexy run its exact pmset commands without
# a password. Installed/removed via `dexy setup-sudo` / `dexy remove-sudo`.
SUDOERS_FILE="/etc/sudoers.d/dexy"

# dexy remembers your battery idle-sleep timeout when it turns on, so `off`
# restores exactly what you had rather than imposing a fixed value (which could
# end up lower than your display-sleep and make pmset complain). The remembered
# value lives here; it's the only state dexy keeps, and on/off is still read
# straight back from the system flag.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dexy"
STATE_FILE="$STATE_DIR/battery-sleep"

# Fallback battery idle-sleep (minutes) for `off` when nothing is remembered
# and DEXY_SLEEP_MINUTES isn't set.
SLEEP_RESTORE_DEFAULT=5

# --- pretty output (honours NO_COLOR and non-TTY) ---------------------------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  DIM=$'\033[2m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RESET=$'\033[0m'
else
  DIM=""; GREEN=""; YELLOW=""; RESET=""
fi

die() { printf 'dexy: %s\n' "$*" >&2; exit 1; }

require_macos() {
  [[ "$(uname -s)" == "Darwin" ]] || die "dexy only works on macOS (it needs pmset)."
  command -v pmset >/dev/null 2>&1 || die "pmset not found — is this really macOS?"
}

# True when sleep is disabled (i.e. dexy is ON).
is_on() {
  [[ "$(pmset -g | awk '/SleepDisabled/ {print $2}')" == "1" ]]
}

# Current configured battery idle-sleep timeout, in minutes. Matches only the
# line whose first field is exactly "sleep" (not displaysleep/disksleep/etc).
battery_sleep_minutes() {
  pmset -g custom | awk '
    /^Battery Power:/ {b=1; next}
    /^AC Power:/      {b=0}
    b && $1=="sleep"  {print $2; exit}'
}

# Save the current battery sleep timeout so `off` can restore it. Only overwrite
# with a positive value: a current 0 is almost always dexy's own leftover (e.g.
# a reboot cleared SleepDisabled but not the sleep timer), so we keep whatever
# real value we saved last rather than clobbering it with 0.
remember_sleep() {
  local cur
  cur="$(battery_sleep_minutes)"
  [[ "$cur" =~ ^[0-9]+$ && "$cur" -gt 0 ]] || return 0
  mkdir -p "$STATE_DIR" && printf '%s\n' "$cur" >"$STATE_FILE"
}

# Minutes `off` should restore battery idle-sleep to, in priority order:
#   1. an explicit DEXY_SLEEP_MINUTES (manual override / back-compat)
#   2. the value remembered when dexy was turned on
#   3. the built-in default
restore_minutes() {
  local saved
  if [[ -n "${DEXY_SLEEP_MINUTES:-}" ]]; then
    printf '%s' "$DEXY_SLEEP_MINUTES"
    return
  fi
  if [[ -r "$STATE_FILE" ]]; then
    saved="$(cat "$STATE_FILE" 2>/dev/null)"
    [[ "$saved" =~ ^[0-9]+$ ]] && { printf '%s' "$saved"; return; }
  fi
  printf '%s' "$SLEEP_RESTORE_DEFAULT"
}

turn_on() {
  remember_sleep
  sudo pmset -b sleep 0 && sudo pmset -b disablesleep 1
}

turn_off() {
  sudo pmset -b sleep "$(restore_minutes)" && sudo pmset -b disablesleep 0
}

print_status() {
  if is_on; then
    printf '%s● dexy: ON%s  %s— wide awake (battery sleep 0, lid-closed sleep disabled)%s\n' \
      "$GREEN" "$RESET" "$DIM" "$RESET"
  else
    printf '%s○ dexy: OFF%s %s— normal sleep (battery sleep %sm, lid-closed enabled)%s\n' \
      "$YELLOW" "$RESET" "$DIM" "$(battery_sleep_minutes)" "$RESET"
  fi
}

# Emit the sudoers rule, scoped to exactly the pmset commands dexy runs:
# battery idle-sleep to any number of minutes, and the lid-closed sleep toggle.
# Nothing else is granted — no general pmset access, no other binaries.
sudoers_rule() {
  local user pmset_path
  user="$(id -un)"
  pmset_path="$(command -v pmset)"
  cat <<EOF
# Installed by 'dexy setup-sudo' — lets dexy toggle sleep without a password.
# Scoped to only the pmset commands dexy uses. Remove with 'dexy remove-sudo'
# (or: sudo rm $SUDOERS_FILE).
$user ALL=(root) NOPASSWD: $pmset_path -b sleep [0-9]*, $pmset_path -b disablesleep 0, $pmset_path -b disablesleep 1
EOF
}

setup_sudo() {
  require_macos
  local tmp
  tmp="$(mktemp)" || die "could not create a temporary file"
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" EXIT
  sudoers_rule >"$tmp"
  # Validate before we ever touch /etc — a broken sudoers file can lock you out
  # of sudo entirely. visudo -cf needs no root, so this can't prompt.
  visudo -cf "$tmp" >/dev/null 2>&1 \
    || die "generated sudoers rule failed validation — nothing was changed"
  printf '%sinstalling %s (you may be asked for your password once)…%s\n' \
    "$DIM" "$SUDOERS_FILE" "$RESET"
  sudo install -m 0440 -o root -g wheel "$tmp" "$SUDOERS_FILE" \
    || die "could not install $SUDOERS_FILE"
  printf '%s✓%s passwordless toggling enabled — %sdexy on/off/toggle no longer prompt%s\n' \
    "$GREEN" "$RESET" "$DIM" "$RESET"
  printf '%s  undo any time with: dexy remove-sudo%s\n' "$DIM" "$RESET"
}

remove_sudo() {
  require_macos
  if [[ ! -e "$SUDOERS_FILE" ]]; then
    printf '%snothing to remove — %s is not installed%s\n' "$DIM" "$SUDOERS_FILE" "$RESET"
    return 0
  fi
  printf '%sremoving %s (you may be asked for your password)…%s\n' \
    "$DIM" "$SUDOERS_FILE" "$RESET"
  sudo rm -f "$SUDOERS_FILE" || die "could not remove $SUDOERS_FILE"
  printf '%s✓%s removed — dexy will prompt for your password again on toggle\n' \
    "$GREEN" "$RESET"
}

usage() {
  cat <<'EOF'
dexy — keep your Mac wide awake. Lid closed, on battery, no nonsense.

USAGE
  dexy [command]

COMMANDS
  (none)        toggle dexy on or off
  on            stay awake — disable sleep, even with the lid shut
  off           restore normal sleep
  status        show the current state
  setup-sudo    allow passwordless toggling (installs a scoped sudoers rule)
  remove-sudo   undo setup-sudo
  -h, --help    show this help
  -v            show version

ENV
  DEXY_SLEEP_MINUTES   override the battery sleep `off` restores to. By default
                       dexy puts back whatever you had before turning on.
  NO_COLOR             disable coloured output

Toggling needs sudo (pmset), so you may be asked for your password. Run
`dexy setup-sudo` once to skip the prompt — it installs a sudoers rule scoped
to only the pmset commands dexy uses.
EOF
}

main() {
  require_macos
  case "${1:-toggle}" in
    on)
      if is_on; then printf '%salready on%s\n' "$DIM" "$RESET"; else turn_on; fi
      print_status
      ;;
    off)
      if is_on; then turn_off; else printf '%salready off%s\n' "$DIM" "$RESET"; fi
      print_status
      ;;
    toggle)
      if is_on; then turn_off; else turn_on; fi
      print_status
      ;;
    status|-s|--status)
      print_status
      ;;
    setup-sudo)
      setup_sudo
      ;;
    remove-sudo)
      remove_sudo
      ;;
    -h|--help|help)
      usage
      ;;
    -v|--version|version)
      printf 'dexy %s\n' "$DEXY_VERSION"
      ;;
    *)
      die "unknown command: $1 (try 'dexy --help')"
      ;;
  esac
}

main "$@"
